[Unit]
Description=Wix Delhivery automation trigger
Wants=network-online.target wixdelhivery.service
After=network-online.target wixdelhivery.service

[Service]
Type=oneshot
EnvironmentFile=/home/saipi/wixdelhivery/.env
ExecStart=/usr/bin/curl -fsS --connect-timeout 10 --max-time 1800 -X POST http://127.0.0.1:3000/api/automation/run -H "Authorization: Bearer ${AUTOMATION_SECRET}" -H "Content-Type: application/json" -d "{\"trigger\":\"systemd\",\"force\":true}"
